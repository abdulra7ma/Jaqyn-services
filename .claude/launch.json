{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "cwd": "frontend",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "web", "dev"],
      "port": 3000,
      "autoPort": false,
      "env": { "API_PROXY_TARGET": "http://127.0.0.1:8000", "NEXT_PUBLIC_DEMO_MODE": "1" }
    },
    {
      "name": "web-preview",
      "cwd": "frontend",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "web", "exec", "next", "dev", "-p", "3100"],
      "port": 3100,
      "autoPort": false,
      "env": { "API_PROXY_TARGET": "http://127.0.0.1:8000" }
    },
    {
      "name": "web-campaigns-preview",
      "cwd": "frontend",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "web", "exec", "next", "dev", "-p", "3200"],
      "port": 3200,
      "autoPort": false,
      "env": { "NEXT_PUBLIC_USE_MOCKS": "true" }
    },
    {
      "name": "landing",
      "cwd": "landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173,
      "autoPort": false,
      "env": { "VITE_API_URL": "http://localhost:8000" }
    }
  ]
}
