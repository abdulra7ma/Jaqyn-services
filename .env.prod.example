# ============================================================================
# PRODUCTION env template — set these in the Railway service "Variables" tab.
# NEVER commit real secrets. This file documents what each service needs.
# ============================================================================

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING
# The web service's Railway-generated host (Settings → Networking → Generate Domain).
DJANGO_ALLOWED_HOSTS=jaqyn-web-production.up.railway.app
# Django admin behind the proxy needs the full https origin:
DJANGO_CSRF_TRUSTED_ORIGINS=https://jaqyn-web-production.up.railway.app

# --- CORS ---
# Not needed in the default setup: the frontend proxies /api through its own
# origin (API_PROXY_TARGET), so requests are same-origin. Leave empty.
DJANGO_CORS_ALLOWED_ORIGINS=

# --- Database (Railway Postgres plugin) ---
# In Railway, reference the Postgres plugin's vars so they auto-populate:
#   POSTGRES_HOST=${{Postgres.PGHOST}}   POSTGRES_PORT=${{Postgres.PGPORT}}
#   POSTGRES_DB=${{Postgres.PGDATABASE}} POSTGRES_USER=${{Postgres.PGUSER}}
#   POSTGRES_PASSWORD=${{Postgres.PGPASSWORD}}
DB_ENGINE=postgres
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# --- Redis (Railway Redis plugin) — reference ${{Redis.REDIS_URL}} ---
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Run-once / lifecycle flags (entrypoint.sh reads these) ---
# Run migrations + collectstatic on the WEB service only. Set both to "false"
# on the worker service so two services don't migrate concurrently.
RUN_MIGRATIONS=true
DJANGO_COLLECTSTATIC=true

# --- Media storage: Cloudflare R2 (S3 API). Free 10GB, zero egress. ---
USE_S3=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=jaqyn-media
AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2's built-in public host (Bucket → Settings → Public access). No domain needed.
AWS_S3_CUSTOM_DOMAIN=pub-<hash>.r2.dev
AWS_S3_REGION_NAME=auto

# --- App: the FRONTEND Railway service URL (QR codes encode this) ---
FRONTEND_URL=https://jaqyn-frontend-production.up.railway.app

# --- Frontend service only: proxy target = the WEB service URL ---
# API_PROXY_TARGET=https://jaqyn-web-production.up.railway.app
# NEXT_PUBLIC_API_URL stays empty (same-origin proxy).

# --- Observability (optional) ---
SENTRY_DSN=

# --- Business rules (keep prod defaults; override only if needed) ---
OTP_TTL_SECONDS=300
OTP_RATE_LIMIT_PER_PHONE=5
OTP_RATE_LIMIT_PER_IP=20
APPROVAL_CODE_FAILED_LIMIT=10
COLLECT_DAILY_LIMIT=1
COLLECT_MIN_INTERVAL_SECONDS=21600

# --- HARD OFF in production (dev/test backdoors) ---
SEED_TEST_USERS=false
DEV_LOGIN_OTP=
