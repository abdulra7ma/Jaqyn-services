# Backend API base URL consumed by the landing form (submitLead).
# Leave empty in production if the landing is served from the same origin as the API.
VITE_API_URL=http://localhost:8000

# Live app (Next.js frontend) base URL. CTAs like "Explore Deals" and "Log in"
# link here. Mirrors the backend FRONTEND_URL. Prod = the deployed frontend host.
VITE_APP_URL=http://localhost:3000

# Public origin of the landing site itself. Baked into canonical/OG/JSON-LD in
# index.html and into robots.txt/sitemap.xml/llms.txt (templates in seo/).
# Prod = the deployed landing host (e.g. https://jaqyn.kg).
VITE_SITE_URL=http://localhost:5173
