DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

DB_ENGINE=postgres
POSTGRES_DB=jaqyn
POSTGRES_USER=jaqyn
POSTGRES_PASSWORD=jaqyn
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

SENTRY_DSN=
OTP_TTL_SECONDS=300
OTP_RATE_LIMIT_PER_PHONE=5
OTP_RATE_LIMIT_PER_IP=20
APPROVAL_CODE_FAILED_LIMIT=10
COLLECT_DAILY_LIMIT=1
COLLECT_MIN_INTERVAL_SECONDS=21600

# Dev/test accounts — keep DISABLED in production.
# SEED_TEST_USERS: seed static clients + a business/staff on startup (idempotent).
# DEV_LOGIN_OTP: when set, this fixed code logs in ANY phone via verify-otp. Leave empty in prod.
# SEED_TEST_PASSWORD: shared password for the seeded email+password fallback logins.
SEED_TEST_USERS=false
SEED_TEST_CLIENT_COUNT=3
SEED_TEST_PASSWORD=password
SEED_TEST_BUSINESS_CODE=TESTCAFE
DEV_LOGIN_OTP=
