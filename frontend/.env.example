# Base URL of the Django backend (browser-reachable).
NEXT_PUBLIC_API_URL=http://localhost:8000

# "true" = drive customer screens from in-memory seed data (offline/demo).
# Unset or any other value = LIVE (calls NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_USE_MOCKS=

# Support/help URL for customer contact links (pitch dead-link screen, etc).
# Defaults to https://t.me/jaqyn if unset.
NEXT_PUBLIC_SUPPORT_URL=
