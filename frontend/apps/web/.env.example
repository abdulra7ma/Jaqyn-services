# Web app env. Copy to .env.local and fill values for local dev.

# Nearby-map provider: "2gis" (default) or "google". Falls back to a built-in SVG map
# if the chosen provider has no key set.
NEXT_PUBLIC_MAP_PROVIDER=2gis

# 2GIS MapGL JS API key (used when NEXT_PUBLIC_MAP_PROVIDER=2gis).
# Public/domain-restricted key from your 2GIS account.
NEXT_PUBLIC_DGIS_MAPGL_KEY=

# Google Maps JS API key (used when NEXT_PUBLIC_MAP_PROVIDER=google).
# Also used by LocationPicker — if unset, the picker falls back to a keyless OpenStreetMap + Nominatim map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Test-only: show the staff scanner's "Upload QR (test)" button. It decodes a QR
# image file and runs the SAME collect flow as a live camera scan. Production: leave unset.
NEXT_PUBLIC_ENABLE_TEST_UPLOAD=false

# Marketing/landing site origin — used for the Privacy Policy + Terms links shown on
# auth/signup screens (legal pages are hosted on the landing site). Defaults to the
# local landing dev server. Set to the deployed landing URL in production.
NEXT_PUBLIC_LANDING_URL=http://localhost:5173

# Sentry DSN (client/server/edge error reporting). Optional — when unset, Sentry is
# a no-op. Not a secret (Sentry DSNs are safe to expose), so NEXT_PUBLIC_ is fine here.
NEXT_PUBLIC_SENTRY_DSN=

# Google OAuth Client ID for "Sign in with Google" (GIS ID-token flow). Same
# value as the backend's GOOGLE_OAUTH_CLIENT_ID — this one is public by design
# (Google's own security model treats the client id as non-secret; no client
# secret is used anywhere in this flow).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public origin of this app itself — single source of truth for absolute self-URLs
# (robots.txt, sitemap.xml, llms.txt, metadataBase / Open Graph). Baked at build time
# (see frontend/Dockerfile). Defaults to the local dev server; prod = the deployed
# app host (e.g. https://app.jaqyn.kg).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
