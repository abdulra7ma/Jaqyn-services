# Web app env. Copy to .env.local and fill values for local dev.

# Nearby-map provider: "2gis" (default) or "google". Falls back to a built-in SVG map
# if the chosen provider has no key set.
NEXT_PUBLIC_MAP_PROVIDER=2gis

# 2GIS MapGL JS API key (used when NEXT_PUBLIC_MAP_PROVIDER=2gis).
# Public/domain-restricted key from your 2GIS account.
NEXT_PUBLIC_DGIS_MAPGL_KEY=

# Google Maps JS API key (used when NEXT_PUBLIC_MAP_PROVIDER=google).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Test-only: show the staff scanner's "Upload QR (test)" button. It decodes a QR
# image file and runs the SAME collect flow as a live camera scan. Production: leave unset.
NEXT_PUBLIC_ENABLE_TEST_UPLOAD=false
